{
  "ConnectionStrings": {
    "MessageBus": "amqp://guest:guest@messaging:5672/"
  },
  "Store": {
    "Provider": "Qdrant",
    "Qdrant": {
      "ConnectionString": "http://qdrant:6334"
    }
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://ollama:11434",
      "Model": "nomic-embed-text"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://telemetry-dashboard:18889",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Issuer": "http://identity:8080/",
    "ValidIssuers": [ "https://localhost:5001/", "http://identity:8080/" ],
    "Swagger": {
      "Issuer": "https://localhost:5001/"
    }
  }
}
